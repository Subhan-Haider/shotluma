{
  "name": "Shotluma — App Store Screenshot Studio",
  "short_name": "Shotluma",
  "description": "Design editable App Store screenshot sets directly in your browser.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#171713",
  "theme_color": "#171713",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
