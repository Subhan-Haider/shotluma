{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shotluma-app",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.shotluma.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
